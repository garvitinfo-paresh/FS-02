-----------------
aggregate
-----------------


1. Count the total number of books
db.books.aggregate([{$count: "totalBooks"}])

2. Find all downloadable books
db.books.aggregate([ {$match: { downloadable: true } }, {$project: { _id: 0, title: 1, downloadable: 1 } }])

3. Calculate the average number of reviews

db.books.aggregate([ 
  {$group: { _id: null, averageReviews: {$avg: "$no_of_reviews" } } }, 
  {$project: { _id: 0, averageReviews: 1 } }
 ])


4. Find the book with the highest number of reviews
db.books.aggregate([ 
  {$sort: { no_of_reviews: -1 } }, 
  {$limit: 1 }, 
  {$project: { _id: 0, title: 1, no_of_reviews: 1 } }
  ])

5. Find the minimum and maximum reviews

db.books.aggregate([
  {$group: { _id: null, minimumReviews: {$min: "$no_of_reviews" }, 
  maximumReviews: {$max: "$no_of_reviews" } }}
])

6. Display books with author experience greater than or equal to 5 years

db.books.aggregate([
  {
    $match: {
      "author.profile.exp": {
        $gte: 5
      }
    }
  },
  {
    $project: {
      _id: 0,
      title: 1,
      authorName: "$author.name",
      experience: "$author.profile.exp"
    }
  }
])